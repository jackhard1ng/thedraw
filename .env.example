# Firebase web config — from the Firebase console (Project settings → Your apps).
# These are safe to expose in the client; access is governed by firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Places (Autocomplete). Restrict this key by HTTP referrer in the
# Google Cloud console. Courses are keyed by place_id, never by name (§3).
VITE_GOOGLE_PLACES_KEY=

# Web push (FCM): the VAPID key pair's public key, from Firebase console →
# Project settings → Cloud Messaging → Web Push certificates.
VITE_FIREBASE_VAPID_KEY=

# Point the app at local Firebase emulators during development.
VITE_USE_EMULATORS=false

# Default market for a fresh signup (§7 market-scoping). Launches: Kansas City.
VITE_DEFAULT_MARKET_ID=kc
